# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Channel ID (например @your_channel или -100xxxxxxxxxx)
TELEGRAM_CHANNEL_ID=@your_channel_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI models
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_GENERATE=gpt-6.1-sol
OPENAI_TRANSLATION_MODEL=gpt-6.1-sol
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Telegram telemetry bot and channel
TELEMETRY_BOT_TOKEN=your_telemetry_bot_token_here
TELEMETRY_CHANNEL_ID=@your_telemetry_channel_here
TELEMETRY_POLL_INTERVAL=15

# F1 live timing and optional F1TV radio authentication
F1_SUBSCRIPTION_TOKEN=your_f1_subscription_token_here
F1_COOKIE_LOGIN_SESSION=
F1_COOKIE_ENTITLEMENT_TOKEN=
CF_POLICY=
CF_SIGNATURE=
CF_KEY_PAIR_ID=

# Интервал проверки новостей в минутах
CHECK_INTERVAL_MINUTES=10

# Минимальный порог хайпа для отправки (8-10)
HYPE_THRESHOLD=8

# Optional image search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Reddit memes
MEME_HOT_SCORE=500
MEME_CHECK_INTERVAL_MINUTES=30
MEME_MAX_AGE_HOURS=24
